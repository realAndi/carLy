#!/bin/sh
# postinst: bring the settings across from CarLyrics.
#
# carLy was called CarLyrics until 1.0 (package com.diffmusicplayer.carlyrics, which this one
# Conflicts with and Replaces, so the package manager removes it). Its settings live in its own
# preference domain; copy them once into carLy's, so offsets, switches and the app list survive
# the rename. A fresh install, or a second run, finds nothing to do.
PREFS=/var/jb/var/mobile/Library/Preferences
OLD="$PREFS/com.diffmusicplayer.carlyrics.plist"
NEW="$PREFS/com.andi.carly.plist"

if [ -f "$OLD" ] && [ ! -f "$NEW" ]; then
    cp -p "$OLD" "$NEW" && chown mobile:mobile "$NEW" 2>/dev/null
    # cfprefsd may already hold an empty copy of the new domain in memory; restarted, it reads
    # the file. It respawns on demand.
    killall -9 cfprefsd 2>/dev/null
fi
exit 0
